# =============================================================================
# Переменные окружения проекта BI · Профиль строителя
# Скопируйте в .env и заполните реальными значениями перед запуском.
# =============================================================================

# --- Backend ---
HTTP_ADDR=:8080

# Postgres (docker-compose сервис postgres, изнутри сети)
PG_DSN=postgres://postgres:postgres@postgres:5432/bigroup?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
# Пароль Redis (requirepass). Пусто — без пароля (только для локальной разработки).
# docker-compose передаёт одно и то же значение и в redis, и в backend.
REDIS_PASSWORD=

# Миграции при старте (1 — применяют, 0 — пропускают)
MIGRATE=1

# Окружение. ОБЯЗАТЕЛЬНО (docker compose без него не стартует).
# dev — локальная разработка: разрешает MIGRATE_RESET, http-origin, слабый пароль админа,
# COOKIE_SECURE по умолчанию 0. Любое другое значение (prod, staging) включает проверки:
# FRONT_ORIGIN только https://, ADMIN_PASSWORD 12+ символов и не admin/admin123,
# COOKIE_SECURE по умолчанию 1. При нарушении сервер отказывается стартовать.
APP_ENV=dev

# 1 — DROP SCHEMA public CASCADE перед миграциями (только при APP_ENV=dev, иначе фатальный отказ).
# Нужен для перехода со старой схемы без docker compose down -v. Данные удаляются!
MIGRATE_RESET=0

# CORS origin фронтенда (точный, куки требуют не "*"). Вне dev — только https://
FRONT_ORIGIN=http://localhost:5173

# Secure-куки: 1 — только по HTTPS, 0 — для локальной разработки.
# Пусто — по умолчанию 1, а при APP_ENV=dev — 0.
COOKIE_SECURE=

# Доверенные reverse-proxy (CIDR или IP через запятую). Только от них берётся
# X-Forwarded-For (правый недоверенный хоп); иначе клиент = TCP-адрес соединения.
# Пример: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Bootstrap первого администратора (создаётся только если таблица users пуста).
# ADMIN_PASSWORD ОБЯЗАТЕЛЕН для docker compose. Вне APP_ENV=dev: 12+ символов,
# не admin/admin123, иначе сервер не стартует. Для dev подойдёт любой, например dev-admin-pass.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# --- Фронтенд (для сборки в Docker) ---
VITE_API_URL=http://localhost:8080
